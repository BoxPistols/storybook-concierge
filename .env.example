# ============================================================================
# Concierge — ローカル開発用 (Direct Mode)
# ============================================================================
# ブラウザから直接 OpenAI / Gemini を呼ぶモード。
# .storybook/main.cjs の define がこの 3 つを読み込む。
# キーは dev サーバー（storybook dev）のバンドルにのみ埋め込まれ、
# build（本番）では main.cjs 側で機械的に空へ落とされる。
# 公開デプロイで AI を動かすときは下の Backend Mode を使うこと。
VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here

# 既定モデル。未設定なら gpt-5.6-luna
VITE_OPENAI_MODEL=gpt-5.6-luna

# ============================================================================
# Concierge — Backend Mode (Vercel deployment 推奨)
# ============================================================================
# /api/ai 経由でサーバープロキシを使うモード。
# - API キーはサーバー env vars に保管（バンドルに含まれない）
# - lib/ratelimit.ts による DAILY_LIMIT 適用
# - X-User-API-Key ヘッダーで自前キー利用時はレート制限免除

# ----------------------------------------------------------------------------
# 以下はサーバー側 env vars (Vercel project settings)
# .env ファイルではなく Vercel ダッシュボードで設定すること
# ----------------------------------------------------------------------------

# 共有プール用のサーバーキー（VITE_ プレフィックスなし、ブラウザに露出しない）
# OPENAI_API_KEY=your_openai_api_key_here
# GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here
# (互換: GEMINI_API_KEY=...)

# レート制限の上限（IP / 日）。デフォルト 20
# DAILY_LIMIT=20

# CORS 許可オリジン（カンマ区切り・スキーム込みの完全一致）。
# localhost / 127.0.0.1 はコード側で常時許可なので書かなくてよい。
# デプロイした Storybook のオリジンをここに列挙する。
# ALLOWED_ORIGINS=https://your-deployment.vercel.app,https://your-org.github.io

# Upstash Redis（任意）
# 未設定なら in-memory カウンタで動く。サーバーレスはインスタンスごとに
# 状態が消えるため、その場合に止まるのはバーストだけで、利用者ごとの通算
# 回数は数えられない。厳密な上限が要るときだけ設定する。
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
#
# Redis キーの名前空間。複数プロダクトで同じ DB を共有するときは、
# プロダクトごとに変える。同じだとカウンタが混ざり、別プロダクトの利用で
# こちらの枠が減る。無料枠の 1 DB で複数製品を賄える
# RATELIMIT_PREFIX=storybook-concierge/ai

# ----------------------------------------------------------------------------
# 請求額の天井はプロバイダ側（OpenAI 等）の予算上限で設ける。
# Origin 許可リストは他サイトのブラウザを止めるが、Origin ヘッダーを付けた
# 直接リクエストは通るため、上限設定が唯一の硬い天井になる。
# ----------------------------------------------------------------------------
